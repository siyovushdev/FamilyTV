{
  "id": "apple-adventure",
  "title": "Приключение с яблоками",
  "schemaVersion": 3,
  "startStepId": "intro",
  "steps": [
    {
      "type": "message",
      "id": "intro",
      "text": "Приключение с яблоками — версия 2! Давай начнём.",
      "continueLabel": "Начать",
      "transitions": { "next": "intro-video" }
    },
    {
      "type": "video",
      "id": "intro-video",
      "mediaRef": "media/intro.mp4",
      "transitions": { "next": "animal-choice" }
    },
    {
      "type": "choice",
      "id": "animal-choice",
      "prompt": "Какое животное живёт в воде?",
      "options": [
        { "id": "fish", "text": "Рыба" },
        { "id": "cat", "text": "Кошка" },
        { "id": "horse", "text": "Лошадь" }
      ],
      "correctOptionId": "fish",
      "feedback": {
        "correct": "Верно! Рыба живёт в воде.",
        "wrong": "Подумай ещё раз",
        "hint": "Это плавает",
        "retryLimit": 5
      },
      "transitions": {
        "onCorrect": "apple-msg",
        "onWrong": "animal-choice",
        "onUnknown": "animal-choice"
      }
    },
    {
      "type": "message",
      "id": "apple-msg",
      "text": "Теперь посчитаем яблоки.",
      "continueLabel": "Дальше",
      "transitions": { "next": "apple-voice" }
    },
    {
      "type": "question",
      "id": "apple-voice",
      "prompt": "Сколько яблок получилось?",
      "questionType": "VOICE_NUMBER",
      "expected": "5",
      "visual": { "kind": "APPLES", "left": 2, "right": 3 },
      "feedback": {
        "correct": "Правильно!",
        "wrong": "Посчитай яблоки ещё раз",
        "unknown": "Скажи число",
        "hint": "2 + 3"
      },
      "transitions": {
        "onCorrect": "stretch",
        "onWrong": "apple-voice",
        "onUnknown": "apple-voice"
      }
    },
    {
      "type": "move",
      "id": "stretch",
      "prompt": "Встань и подпрыгни пять раз!",
      "durationSeconds": 15,
      "continueMode": "button",
      "continueLabel": "Я попрыгал",
      "transitions": { "next": "finale-video" }
    },
    {
      "type": "video",
      "id": "finale-video",
      "mediaRef": "media/finale.mp4",
      "transitions": { "next": "outro" }
    },
    {
      "type": "message",
      "id": "outro",
      "text": "Ура! Приключение v2 закончено.",
      "continueLabel": "Готово",
      "transitions": { "next": "__end__" }
    }
  ]
}
