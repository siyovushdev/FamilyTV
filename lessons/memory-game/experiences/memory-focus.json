      "id": "how-many",
      "prompt": "Сколько яблок нужно было запомнить?",
      "options": [
        {
          "id": "two",
          "text": "Два"
        },
        {
          "id": "three",
          "text": "Три"
        },
        {
          "id": "five",
          "text": "Пять"
        }
      ],
      "correctOptionId": "three",
      "feedback": {
        "correct": "Точно! Три.",
        "wrong": "Вспомни начало: три яблока.",
