      },
      "transitions": {
        "onCorrect": "order",
        "onWrong": "how-many",
        "onUnknown": "how-many"
      }
    },
    {
      "type": "choice",
      "id": "order",
      "prompt": "Что было раньше: подсказка или видео?",
      "options": [
        {
          "id": "hint",
          "text": "Подсказка"
        },
        {
          "id": "video",
          "text": "Видео"
        }
      ],
      "correctOptionId": "hint",
      "feedback": {
        "correct": "Да, сначала была подсказка.",
        "wrong": "Сначала мы сказали про три яблока.",
        "hint": "Попробуй ещё раз спокойно"
      },
      "transitions": {
        "onCorrect": "bye",
        "onWrong": "order",
        "onUnknown": "order"
      }
    },
    {
      "type": "message",
      "id": "bye",
      "text": "Внимание помогает учиться. Молодец!",
      "continueLabel": "Готово",
      "transitions": {
        "next": "__end__"
      }
    }
