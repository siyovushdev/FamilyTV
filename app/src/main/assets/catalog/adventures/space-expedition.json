{
  "schemaVersion": 1,
  "id": "space-expedition",
  "title": "Космическая экспедиция",
  "world": "explore",
  "readingSupport": "AUDIO_FIRST",
  "description": "Почините корабль, проложите курс и исследуйте планету — обучение внутри миссии.",
  "learningGoals": ["COUNTING", "CLASSIFICATION", "PATTERN_RECOGNITION", "SPATIAL_REASONING", "SCIENCE_REASONING", "COOPERATION"],
  "estimatedMinutes": 12,
  "difficulty": { "min": 1, "max": 3 },
  "startSceneId": "intro",
