        "mechanic": "VISUAL_SEARCH",
        "prompt": "Вставь три синие батарейки энергии в пустые места на корабле.",
        "spokenPrompt": "Найди три синие батарейки и поставь их в корабль.",
        "promptAudio": "space-expedition/ship-power.wav",
        "learningGoals": ["CLASSIFICATION", "COUNTING"],
        "scaffolding": {
          "hint1": "Смотри на пустые места у двигателя.",
          "hint2": "Подходят только синие батарейки энергии.",
          "visualHint": true,
          "explanation": "Три батарейки энергии заряжают двигатель. Камень, ключ и звезда не дают силу.",
          "simplifiedParams": {
            "objects": [
              { "id": "cell_a", "label": "Энергия", "voiceAliases": ["энергия", "батарейка", "батарея"] },
              { "id": "cell_b", "label": "Энергия", "voiceAliases": ["энергия", "батарейка"] },
              { "id": "rock", "label": "Камень", "voiceAliases": ["камень"] }
            ],
            "requiredIds": ["cell_a", "cell_b"],
            "minSelect": 2
          }
        },
        "params": {
          "objects": [
            { "id": "cell_a", "label": "Энергия", "voiceAliases": ["энергия", "батарейка", "батарея", "ячейка"] },
