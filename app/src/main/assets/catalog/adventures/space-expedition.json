    { "id": "launch", "title": "Запуск", "description": "Вставить энергию и запустить двигатель" },
    { "id": "navigate", "title": "Курс", "description": "Пройти маршрут по чётным числам" },
    { "id": "repair", "title": "Ремонт", "description": "Восстановить последовательность" },
    { "id": "observe", "title": "Наблюдение", "description": "Классифицировать объекты планеты" }
  ],
  "guide": { "id": "lumi", "name": "Луми", "defaultEmotion": "CURIOUS" },
  "scenes": [
    {
      "id": "intro",
      "kind": "STORY",
      "text": "Корабль «Северное сияние» не может взлететь — в двигателе нет энергии.",
      "spokenPrompt": "Смотри: у корабля пустые места. Двигатель молчит. Нужна энергия!",
      "narrationAudio": "space-expedition/intro.wav",
      "guideLine": "Я Луми. Смотри на двигатель — он не горит. Давай починим!",
      "guideEmotion": "EXCITED",
      "groupMode": "ALL_TOGETHER",
      "next": "launch_repair",
      "background": "hangar"
    },
    {
      "id": "launch_repair",
      "kind": "CHALLENGE",
      "groupMode": "DISCUSS_TOGETHER",
      "background": "hangar",
      "challenge": {
