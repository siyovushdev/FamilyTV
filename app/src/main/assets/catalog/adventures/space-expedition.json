            { "id": "cell_b", "label": "Энергия", "voiceAliases": ["энергия", "батарейка", "батарея"] },
            { "id": "wrench", "label": "Ключ", "voiceAliases": ["ключ", "гаечный"] },
            { "id": "cell_c", "label": "Энергия", "voiceAliases": ["энергия", "батарейка", "батарея"] },
            { "id": "star", "label": "Звезда", "voiceAliases": ["звезда"] }
          ],
          "requiredIds": ["cell_a", "cell_b", "cell_c"],
          "minSelect": 3
        },
        "successSets": { "shipPower": 1, "obj:launch": 1 },
        "successNext": "launch_flight"
      }
    },
    {
      "id": "launch_flight",
      "kind": "STORY",
      "text": "Энергия на месте — двигатель ревёт, корабль уходит в космос!",
      "spokenPrompt": "Ура! Двигатель работает. Корабль летит дальше!",
      "narrationAudio": "space-expedition/launch-flight.wav",
      "guideLine": "Мы взлетели! Теперь проложим курс между звёздами.",
